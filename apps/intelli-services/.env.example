# OpenAI兼容API配置(用于文本生成)  https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-5
OPENAI_MODEL=gpt-4o-mini

# 通义万相API配置(用于图片生成)  https://bailian.console.aliyun.com/?tab=globalset#/efm/api_key
TONGYI_API_KEY=sk-your-tongyi-api-key-here

# 服务器配置
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# 缓存配置
LLM_CACHE_ENABLED=true

# 如希望所有模型都强制使用严格 schema，可设置 true
REVIEWER_STRICT_TOOLS=false

# 如想完全关闭 ReAct（即永远走简化流程），可设置 true
REVIEWER_DISABLE_REACT=false