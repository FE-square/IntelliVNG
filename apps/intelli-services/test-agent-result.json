  "script": [
    {
      "id": "START_01",
      "type": "scene",
      "isStart": true,
      "isEnding": false,
      "position": {
        "x": 400,
        "y": 50
      },
      "title": "图书馆奇遇",
      "sceneName": "图书馆阅览室",
      "backgroundId": "scene_001",
      "narration": "阳光透过巨大的落地窗洒进图书馆阅览室，书架间弥漫着知识的芬芳。晓晨正埋首于一堆古籍中，试图从历史的尘埃里寻找毕业论文的灵感。",
      "dialogues": [
        {
          "id": "ygaya24cxt",
          "characterId": "u81kbzhl1m",
          "text": "她手指拂过一本厚重的典籍，却在不经意间瞥见，角落里一本封面古朴的《星辰秘语》似乎发出微弱的光芒，书脊上的纹路如同活了一般，轻轻颤动着。",
          "emotion": "neutral"
        },
        {
          "id": "xsuwa3l4tr",
          "characterId": "char_001",
          "text": "嗯？是我眼花了？还是……这书真的在发光？",
          "emotion": "curious"
        },
        {
          "id": "kyn2zslwgx",
          "characterId": "u81kbzhl1m",
          "text": "晓晨揉了揉眼睛，再次仔细看去。那微光依旧，甚至带着一丝若有若无的低语，像是在召唤着她。",
          "emotion": "mysterious"
        },
        {
          "id": "mokf5hujvn",
          "characterId": "char_003",
          "text": "晓晨！我可算找到你了！你猜我刚才听说了什么大八卦？高数老师居然被拍到在校外和…哎哟！你干嘛呢？鬼鬼祟祟的，对着一本书发呆？",
          "emotion": "excited"
        },
        {
          "id": "g8rbm4y1q7",
          "characterId": "char_001",
          "text": "嘘！小声点！这里是图书馆，雨萱。我…我好像看到了一点不寻常的东西。",
          "emotion": "cautious"
        },
        {
          "id": "8zmammxbb9",
          "characterId": "char_003",
          "text": "不寻常的东西？快给我看看！难道是图书馆闹鬼？还是有神秘社团在偷偷举行仪式？这可是大新闻啊！",
          "emotion": "eager"
        }
      ],
      "nextNodeId": "SCENE_02"
    },
    {
      "id": "SCENE_02",
      "type": "scene",
      "isStart": false,
      "isEnding": false,
      "position": {
        "x": 400,
        "y": 200
      },
      "title": "校园怪事频发",
      "sceneName": "校园林荫道",
      "backgroundId": "scene_002",
      "narration": "阳光透过茂密的树叶，在林荫道上洒下斑驳的光影。然而，最近校园里流传的奇怪传闻，让这份初夏的宁静蒙上了一层不安的色彩。晓晨和雨萱正走在路上，雨萱兴奋的讨论声打破了沉默。",
      "dialogues": [
        {
          "id": "f94naw8ozh",
          "characterId": "char_003",
          "text": "晓晨晓晨！你听说了吗？今天早上，艺术系那边的石膏像，眼睛里竟然流出了红色的颜料，跟哭了一样！",
          "emotion": "excited"
        },
        {
          "id": "pg8a9di363",
          "characterId": "char_001",
          "text": "嗯，不止这件。我刚听说，食堂后厨的冷藏室，昨天晚上自己跳闸了，所有食材都坏了，损失惨重。",
          "emotion": "concerned"
        },
        {
          "id": "em6pw3fb5q",
          "characterId": "char_003",
          "text": "哇！真的假的？这比校报头条还有意思啊！我得赶紧去拍点照片，采访一下目击者！这不就是活生生的都市传说吗？",
          "emotion": "enthusiastic"
        },
        {
          "id": "8x5c0ktlh3",
          "characterId": "char_001",
          "text": "总觉得这些事，和那天图书馆那本书，有某种关联...",
          "emotion": "thoughtful"
        },
        {
          "id": "9375hsxkbn",
          "characterId": "char_002",
          "text": "有些被唤醒的尘埃，需要时间才能重新沉淀。",
          "emotion": "calm"
        },
        {
          "id": "kme7rjnd7u",
          "characterId": "char_001",
          "text": "啊？修远同学？你刚刚...是在和我们说话吗？",
          "emotion": "surprised"
        },
        {
          "id": "6o98l5yr87",
          "characterId": "char_002",
          "text": "只是有感而发。好奇心是求知的动力，但也可能是引火的源头。",
          "emotion": "neutral"
        }
      ],
      "nextNodeId": "SCENE_03"
    },
    {
      "id": "SCENE_03",
      "type": "scene",
      "isStart": false,
      "isEnding": false,
      "position": {
        "x": 400,
        "y": 350
      },
      "title": "线索汇集",
      "sceneName": "学生宿舍",
      "backgroundId": "scene_003",
      "narration": "宿舍里，台灯发出昏黄的光。桌上散落着几张写满笔记的纸，还有那本从图书馆借来的旧书。雨萱坐在床边，一脸焦急地看着正在沉思的晓晨。",
      "dialogues": [
        {
          "id": "igqtbpn8f6",
          "characterId": "char_003",
          "text": "喂，晓晨，快把你今天发现的都说出来！修远学长那句话，‘有时，最显眼的地方反而最容易被忽略’，到底是什么意思？",
          "emotion": "eager"
        },
        {
          "id": "xhr1xkxyfd",
          "characterId": "char_001",
          "text": "别急，让我想想。怪事发生的地点，总是在校园偏僻的角落，比如旧实验楼后面，或者是体育馆地下室的通风口附近。",
          "emotion": "thoughtful"
        },
        {
          "id": "rt3jgrp4b2",
          "characterId": "char_003",
          "text": "对对！而且每次都伴随着一些莫名其妙的骚动，却又抓不到源头。",
          "emotion": "intrigued"
        },
        {
          "id": "jgp9rg875l",
          "characterId": "char_001",
          "text": "如果把这些事件、图书馆那本《失落的传说》里提到的古老传说，再结合修远学长的话... ‘最显眼的地方’和‘最容易被忽略’... 它们并不矛盾。",
          "emotion": "pensive"
        },
        {
          "id": "k7x4ddg2un",
          "characterId": "char_003",
          "text": "你的意思是... 有一个地方，它平时就在我们眼前，却因为某种原因被我们忽略了它的异常？",
          "emotion": "speculative"
        },
        {
          "id": "qrvlh2e8d3",
          "characterId": "char_001",
          "text": "没错。我父亲以前说过，越是看似平常，越可能隐藏着不寻常。这些线索都指向一个地方，一个我们几乎不会注意到的——旧礼堂的废弃储藏室。",
          "emotion": "determined"
        }
      ],
      "nextNodeId": "SCENE_04"
    },
    {
      "id": "SCENE_04",
      "type": "scene",
      "isStart": false,
      "isEnding": false,
      "position": {
        "x": 400,
        "y": 500
      },
      "title": "修远的警告",
      "sceneName": "图书馆阅览室",
      "backgroundId": "scene_001",
      "narration": "阅览室里，阳光透过落地窗洒在书架上，空气中弥漫着旧书特有的气息。晓晨深吸一口气，她在书桌的尽头找到了正在翻阅古籍的修远。",
      "dialogues": [
        {
          "id": "5urlavhsdu",
          "characterId": "char_001",
          "text": "学长，打扰一下。我想问你关于旧礼堂废弃储藏室的事。",
          "emotion": "eager"
        },
        {
          "id": "xsl3zzsrb3",
          "characterId": "char_002",
          "text": "……那地方没什么好说的。",
          "emotion": "neutral"
        },
        {
          "id": "5esej0l23l",
          "characterId": "char_001",
          "text": "可是，我们发现了一些线索，觉得那里可能和最近学校的怪事有关。你是不是知道些什么？",
          "emotion": "curious"
        },
        {
          "id": "m5ogg6urb4",
          "characterId": "char_002",
          "text": "有些门，最好永远不要打开。有些秘密，也最好永远尘封。",
          "emotion": "serious"
        },
        {
          "id": "lwbqjkta1l",
          "characterId": "char_001",
          "text": "你是指……那里有危险吗？",
          "emotion": "concerned"
        },
        {
          "id": "em3joto3tt",
          "characterId": "char_002",
          "text": "我只是建议，适可而止。好奇心……有时会带来不必要的麻烦。",
          "emotion": "solemn"
        }
      ],
      "nextNodeId": "SCENE_05"
    },
    {
      "id": "SCENE_05",
      "type": "scene",
      "isStart": false,
      "isEnding": false,
      "position": {
        "x": 400,
        "y": 650
      },
      "title": "地下室入口",
      "sceneName": "图书馆阅览室",
      "backgroundId": "scene_001",
      "narration": "晓晨和雨萱根据之前的线索，在图书馆废弃书籍堆积的角落里小心翼翼地搜寻着。终于，她们发现了一扇隐藏在书架后的金属门，上面落满了厚厚的灰尘。",
      "dialogues": [
        {
          "id": "zzdgach96",
          "characterId": "char_001",
          "text": "找到了！雨萱，你看，这就是图纸上标注的地下室入口！",
          "emotion": "excited"
        },
        {
          "id": "pub5apd8o9",
          "characterId": "char_003",
          "text": "哇，好隐秘啊。上面这么多灰，平时根本不会有人注意到吧？看来我们找对地方了。",
          "emotion": "curious"
        },
        {
          "id": "1zw8qvmv4p",
          "characterId": "char_001",
          "text": "没错，这应该就是通往旧礼堂储藏室的秘密通道！我们进去看看！",
          "emotion": "eager"
        },
        {
          "id": "9xhrk32xp6",
          "characterId": "u81kbzhl1m",
          "text": "晓晨正准备伸手推开那扇锈迹斑斑的金属门，一道清冷的声音从她们身后传来。",
          "emotion": "neutral"
        },
        {
          "id": "ukw1460u5x",
          "characterId": "char_002",
          "text": "你们不能进去。",
          "emotion": "calm_firm"
        },
        {
          "id": "vrju9cgy4m",
          "characterId": "char_001",
          "text": "（吓了一跳，转过身）修远哥？你怎么会在这里？",
          "emotion": "surprised"
        },
        {
          "id": "7fi0mex4e3",
          "characterId": "char_002",
          "text": "我警告过你，有些地方不该碰。里面不是你们能处理的。",
          "emotion": "serious"
        },
        {
          "id": "pg6kvxacv6",
          "characterId": "char_003",
          "text": "（眉头微皱）修远同学，你这话说得太奇怪了吧？我们只是想查清楚一些事情。",
          "emotion": "questioning"
        }
      ],
      "nextNodeId": "BRANCH_06"
    },
    {
      "id": "BRANCH_06",
      "type": "branch",
      "isStart": false,
      "isEnding": false,
      "position": {
        "x": 400,
        "y": 800
      },
      "title": "如何应对修远的阻拦？",
      "sceneName": "图书馆入口",
      "narration": "图书馆地下室入口的微弱灯光下，修远的身影仿佛一堵无形的高墙，挡住了晓晨和雨萱的去路。他的眼神深邃，平静中带着不容置疑的坚决。",
      "dialogues": [
        {
          "id": "9wa757206z",
          "characterId": "char_002",
          "text": "你们不该到这里来。再往前一步，就是深渊。",
          "emotion": "serious"
        },
        {
          "id": "ns8onwb26u",
          "characterId": "char_001",
          "text": "深渊？修远学长，你到底知道些什么？为什么不肯告诉我们？",
          "emotion": "frustrated"
        },
        {
          "id": "ew5itdd3vn",
          "characterId": "char_002",
          "text": "有些真相，远比你们想象的更残酷。知道得越多，危险就越大。",
          "emotion": "warning"
        },
        {
          "id": "gex1i31ah7",
          "characterId": "char_003",
          "text": "可是，我们已经走到这里了。如果真有什么危险，难道我们不应该知道吗？也许我们可以帮你。",
          "emotion": "pleading"
        },
        {
          "id": "fe2az8f5og",
          "characterId": "char_002",
          "text": "这不是你们能解决的问题。听我的，离开这里，忘掉这一切。",
          "emotion": "firm"
        },
        {
          "id": "psuwvisxt7",
          "characterId": "char_001",
          "text": "不！我们不能退缩。一定有办法的。",
          "emotion": "determined"
        }
      ],
      "choices": [
        {
          "id": "CHOICE_06_A",
          "text": "晓晨：设法支开修远，强行进入地下室。",
          "targetNodeId": "SCENE_07A",
          "condition": "与修远的关系恶化，但可能更快触及真相。"
        },
        {
          "id": "CHOICE_06_B",
          "text": "雨萱：尝试说服修远，寻求他的合作。",
          "targetNodeId": "SCENE_07B",
          "condition": "修远可能泄露部分信息，但提出条件。"
        },
        {
          "id": "CHOICE_06_C",
          "text": "两人：暂时撤退，从校外或网络寻找更多线索。",
          "targetNodeId": "SCENE_07C",
          "condition": "进展缓慢，但可能发现更广的关联。"
        }
      ]
    },
    {
      "id": "SCENE_07A",
      "type": "scene",
      "isStart": false,
      "isEnding": false,
      "position": {
        "x": 150,
        "y": 950
      },
      "title": "强行突破",
      "sceneName": "图书馆地下室",
      "backgroundId": "scene_004",
      "narration": "修远被晓晨巧妙地支开，地下室的门吱呀一声，露出了深不见底的黑暗。霉味和灰尘的气息扑面而来，仿佛时间在这里凝固了。两人打开手机手电筒，小心翼翼地走了进去。",
      "dialogues": [
        {
          "id": "sifiz62sup",
          "characterId": "char_003",
          "text": "哇哦，这里简直是个废弃的世界。修远为什么不让我们进来啊？",
          "emotion": "curious"
        },
        {
          "id": "7aa18p2nuf",
          "characterId": "char_001",
          "text": "他肯定有他的理由，但我总觉得事有蹊跷。我们分头找找，看有没有什么特别的。",
          "emotion": "determined"
        },
        {
          "id": "sdnces7ojt",
          "characterId": "char_003",
          "text": "好！咦，这里有个上了锁的柜子。",
          "emotion": "surprised"
        },
        {
          "id": "per8l510y5",
          "characterId": "char_001",
          "text": "（她用发卡小心翼翼地拨弄着锁芯，咔哒一声，锁开了）找到了。这里面是…一些档案？",
          "emotion": "focused"
        },
        {
          "id": "5lpgpmz2d6",
          "characterId": "char_003",
          "text": "（凑近阅读）天啊，这些都是关于几年前那起失踪案的调查报告！还有些名字…和我们学校的学生对得上！",
          "emotion": "shocked"
        },
        {
          "id": "dsl5gqbdyu",
          "characterId": "char_001",
          "text": "这和修远说的完全不一样…这里面记录的信息，远比我们想象的要复杂和黑暗。",
          "emotion": "serious"
        }
      ],
      "nextNodeId": "SCENE_08"
    },
    {
      "id": "SCENE_07B",
      "type": "scene",
      "isStart": false,
      "isEnding": false,
      "position": {
        "x": 400,
        "y": 950
      },
      "title": "有条件的合作",
      "sceneName": "图书馆阅览室",
      "backgroundId": "scene_001",
      "narration": "阅览室里，阳光透过落地窗洒在布满灰尘的书架上，空气中弥漫着旧书特有的气息。修远将她们带到了一个偏僻的角落，脸色依旧平静，但眼神中多了一丝无奈。",
      "dialogues": [
        {
          "id": "31ibxofhpe",
          "characterId": "char_003",
          "text": "修远同学，现在可以说了吧？地下室到底有什么？你为什么不让我们进去？",
          "emotion": "eager"
        },
        {
          "id": "ezpp4ymr3a",
          "characterId": "char_002",
          "text": "有些事情，你们最好不要知道。但既然你们执意如此...",
          "emotion": "reluctant"
        },
        {
          "id": "uw2lvjv7rk",
          "characterId": "char_002",
          "text": "地下室连接着一个被遗忘的区域，一个...不该被外界打扰的地方。它与最近学校里发生的一些传闻，确实有所关联。",
          "emotion": "serious"
        },
        {
          "id": "buhkzlyjus",
          "characterId": "char_001",
          "text": "不该被外界打扰？是指什么？和我们正在调查的‘奇怪事件’有关吗？",
          "emotion": "curious"
        },
        {
          "id": "eaufy3uw42",
          "characterId": "char_002",
          "text": "具体是什么，我现在不能说得太多。但我可以给你们提供一些帮助，前提是，你们必须答应我两个条件。",
          "emotion": "calm"
        },
        {
          "id": "nghsqmn1sy",
          "characterId": "char_003",
          "text": "什么条件？快说！",
          "emotion": "impatient"
        },
        {
          "id": "g7fwkkbcbm",
          "characterId": "char_002",
          "text": "第一，无论你们发现了什么，都不能擅自行动，必须先告诉我。第二，务必确保你们自身的安全，因为那里确实有危险。",
          "emotion": "caution"
        },
        {
          "id": "1irhmgle8u",
          "characterId": "char_001",
          "text": "你为什么这么做？你到底知道多少？",
          "emotion": "suspicious"
        }
      ],
      "nextNodeId": "SCENE_08"
    },
    {
      "id": "SCENE_07C",
      "type": "scene",
      "isStart": false,
      "isEnding": false,
      "position": {
        "x": 650,
        "y": 950
      },
      "title": "迂回调查",
      "sceneName": "校园林荫道",
      "backgroundId": "scene_002",
      "narration": "午后，阳光透过林荫道的树叶，斑驳地洒在地面上。晓晨和雨萱坐在长椅上，手机和笔记本摊开在两人之间，空气中弥漫着压抑的兴奋。",
      "dialogues": [
        {
          "id": "ydix1bo9z8",
          "characterId": "char_003",
          "text": "你看这个！我查了校报的旧档案，还有一些外部新闻媒体的报道。两年前那场实验室事故的调查报告，结尾被草草盖过，说只是学生操作失误！",
          "emotion": "indignant"
        },
        {
          "id": "7us5ia9lod",
          "characterId": "char_001",
          "text": "操作失误？但当时听说的可不是这样。修远之前警告我们，说有些事情牵扯太深，可能指的就是这个。你再看看财务记录。",
          "emotion": "thoughtful"
        },
        {
          "id": "sseoyiugjj",
          "characterId": "char_003",
          "text": "财务记录更可疑！你看，事故发生后不久，有一笔对外宣称用于“校园设施升级”的巨额资金，但具体用途语焉不详，而且经手人是好几个校领导。",
          "emotion": "frustrated"
        },
        {
          "id": "hfoplveay2",
          "characterId": "char_001",
          "text": "结合修远的警告和这份报告的蹊跷...这根本不是简单的意外。这笔资金，很可能就是用来堵住那些知道真相的人的嘴，或者掩盖更深层的丑闻。",
          "emotion": "serious"
        },
        {
          "id": "6axtn8lrim",
          "characterId": "char_003",
          "text": "所以，校方高层从一开始就介入了，而且还试图掩盖一切？这太恶劣了！我们该怎么办？",
          "emotion": "angry"
        },
        {
          "id": "65n22q7sdm",
          "characterId": "char_001",
          "text": "他们以为可以一手遮天，但蛛丝马迹总会留下。既然修远不肯直接说，那我们就自己把这些线索串起来。",
          "emotion": "determined"
        }
      ],
      "nextNodeId": "SCENE_08"
    },
    {
      "id": "SCENE_08",
      "type": "scene",
      "isStart": false,
      "isEnding": false,
      "position": {
        "x": 400,
        "y": 1100
      },
      "title": "真相的重量",
      "sceneName": "图书馆地下室",
      "backgroundId": "scene_004",
      "narration": "灰尘在昏暗的光线中飞舞，空气凝重得仿佛能滴出水来。那泛黄的档案袋里，记载着一个被刻意尘封多年的秘密，一个足以颠覆所有人心中的校园传说。",
      "dialogues": [
        {
          "id": "t0y26njya3",
          "characterId": "char_003",
          "text": "这...这上面说的...竟然是真的？！当年的失踪案，根本不是意外，而是有人蓄意为之，甚至...被校方压了下来！",
          "emotion": "shocked"
        },
        {
          "id": "7x9q5sktij",
          "characterId": "char_001",
          "text": "那些受害者，那些被遗忘的名字...原来他们不是失踪，是牺牲。这份档案，简直是铁证！",
          "emotion": "grave"
        },
        {
          "id": "xxwmlwta3h",
          "characterId": "char_003",
          "text": "我受够了这些遮掩！这些肮脏的秘密必须被公之于众！我要把它们发到校报头版，让所有人都知道真相！",
          "emotion": "furious"
        },
        {
          "id": "hftsej36sm",
          "characterId": "char_001",
          "text": "等等，雨萱！这份真相的代价，可能会比我们想象的还要大。这牵扯到学校高层，甚至可能会毁了很多人...",
          "emotion": "conflicted"
        },
        {
          "id": "i3ea6c49kn",
          "characterId": "char_002",
          "text": "你们果然还是找到了这里。",
          "emotion": "calm"
        },
        {
          "id": "8xbyuqgfj2",
          "characterId": "char_003",
          "text": "修远？！你怎么会在这里？你是不是也知道些什么？",
          "emotion": "surprised"
        },
        {
          "id": "bcue07ldgx",
          "characterId": "char_002",
          "text": "这份档案，从一开始就不应该被你们发现。有些真相，埋藏起来，对所有人来说，才是最好的结局。",
          "emotion": "serious"
        },
        {
          "id": "suiqrfqwbd",
          "characterId": "char_001",
          "text": "不！修远哥，那不是最好的结局！那些被掩盖的痛苦，那些无辜的人，他们值得一个公道！",
          "emotion": "determined"
        }
      ],
      "nextNodeId": "BRANCH_09"
    },
    {
      "id": "BRANCH_09",
      "type": "branch",
      "isStart": false,
      "isEnding": false,
      "position": {
        "x": 400,
        "y": 1250
      },
      "title": "如何处理真相？",
      "sceneName": "图书馆地下室",
      "backgroundId": "scene_004",
      "narration": "图书馆地下室的空气仿佛凝固了，潮湿与尘埃的气息中，三人的争执声格外刺耳。摆在他们面前的，是沉甸甸的真相和同样沉甸甸的抉择。",
      "dialogues": [
        {
          "id": "wndgdahqid",
          "characterId": "char_003",
          "text": "这些档案就是铁证！我们不能坐视不理，必须把它公布出去，让所有人都知道！",
          "emotion": "indignant"
        },
        {
          "id": "3o00sqo3is",
          "characterId": "char_002",
          "text": "曝光？你考虑过后果吗？你以为这只是简单的揭露？这背后牵扯的，远比你们想象中更深，更复杂。",
          "emotion": "grave"
        },
        {
          "id": "p5xdgx14su",
          "characterId": "char_001",
          "text": "可是修远，如果我们就这样把真相掩埋，那和那些坏人又有什么区别？难道不正义吗？",
          "emotion": "conflicted"
        },
        {
          "id": "w7k50sa42g",
          "characterId": "char_002",
          "text": "正义不等于鲁莽。不计后果的曝光，可能只会引火烧身，让更多无辜的人受牵连。你们真的准备好承受这一切了吗？",
          "emotion": "serious"
        },
        {
          "id": "dvis7g13ii",
          "characterId": "char_003",
          "text": "我......我不能放弃！那些受害者，那些被蒙蔽的人们，他们有权知道！",
          "emotion": "determined"
        },
        {
          "id": "vgbv86ftev",
          "characterId": "char_001",
          "text": "（看着眼前堆积如山的档案，和面前争执不休的两人，她深吸一口气）",
          "emotion": "resolved"
        }
      ],
      "choices": [
        {
          "id": "CHOICE_09_A",
          "text": "雨萱：全面曝光，让所有人都知道真相！",
          "targetNodeId": "ENDING_A",
          "condition": "学校陷入危机，个人付出巨大代价。"
        },
        {
          "id": "CHOICE_09_B",
          "text": "晓晨：揭露部分关键信息，保护无辜者和学校声誉。",
          "targetNodeId": "ENDING_B",
          "condition": "在平衡中寻求脆弱的和解。"
        },
        {
          "id": "CHOICE_09_C",
          "text": "修远：彻底封存秘密，让一切归于沉寂。",
          "targetNodeId": "ENDING_C",
          "condition": "真相被掩埋，友情面临考验。"
        }
      ]
    },
    {
      "id": "ENDING_A",
      "type": "ending",
      "isStart": false,
      "isEnding": true,
      "position": {
        "x": 150,
        "y": 1400
      },
      "title": "真相的代价：校史震荡",
      "sceneName": "校园林荫道",
      "backgroundId": "scene_002",
      "narration": "秋风萧瑟，卷起地上枯黄的落叶。曾经充满欢声笑语的林荫道，此刻却弥漫着沉重的寂静。三人并肩而立，却感受不到丝毫往日的亲密，只有一道无法逾越的鸿沟。",
      "dialogues": [
        {
          "id": "pg2qnuamw8",
          "characterId": "char_001",
          "text": "我们...真的做对了吗？揭露了一切，可看看现在...",
          "emotion": "regretful"
        },
        {
          "id": "vs53bxgxq3",
          "characterId": "char_003",
          "text": "校报的头条轰动了整个教育界，所有人都知道了青云大学的丑闻。可我...我却高兴不起来。",
          "emotion": "somber"
        },
        {
          "id": "giss29mf3q",
          "characterId": "char_002",
          "text": "真相，并非总是带来解脱。有些伤疤，一旦揭开，便再也无法愈合。",
          "emotion": "resigned"
        },
        {
          "id": "3e37ruectx",
          "characterId": "char_001",
          "text": "我们的友谊...也成了代价，是吗？",
          "emotion": "sad"
        },
        {
          "id": "9m5f0cyq9l",
          "characterId": "char_003",
          "text": "（她别过脸，眼眶泛红）我只是...想追求真相。",
          "emotion": "guilty"
        },
        {
          "id": "0yshbqildp",
          "characterId": "char_002",
          "text": "（他只是静静地看着远方，没有回答，仿佛在看一段已经逝去的往事）",
          "emotion": "melancholy"
        }
      ]
    },
    {
      "id": "ENDING_B",
      "type": "ending",
      "isStart": false,
      "isEnding": true,
      "position": {
        "x": 400,
        "y": 1400
      },
      "title": "平衡的艺术：脆弱的和解",
      "sceneName": "图书馆阅览室",
      "backgroundId": "scene_001",
      "narration": "阳光透过阅览室的落地窗，柔和地洒在书架和桌面。空气中弥漫着旧书特有的淡香，比地下室的潮湿冷清多了几分暖意。失踪案的余波渐渐平息，但留下的痕迹，仍在三人心头。",
      "dialogues": [
        {
          "id": "j70imtbmnz",
          "characterId": "char_003",
          "text": "所以，这就是我们能做到的最好结果了吗？一部分真相公之于众，学校也做了些表面功夫...",
          "emotion": "frustrated"
        },
        {
          "id": "cw5z1u2ke0",
          "characterId": "char_001",
          "text": "至少，那些不为人知的角落被照亮了一点。而且，学校承诺会加强管理，虽然只是有限的整改，但总比什么都不做好。",
          "emotion": "thoughtful"
        },
        {
          "id": "nm25g3okqc",
          "characterId": "char_002",
          "text": "世上的事，本就很难非黑即白。真相是一把双刃剑，完全的揭露有时会带来更大的混乱。我们选择了让更多人得以警醒，同时避免了对更多无辜者的伤害。",
          "emotion": "calm"
        },
        {
          "id": "xkxsr654ew",
          "characterId": "char_003",
          "text": "道理我都懂...只是觉得，那些被遗忘的，真的就能这样被放下吗？",
          "emotion": "melancholy"
        },
        {
          "id": "r185asc8v8",
          "characterId": "char_001",
          "text": "我们无法改变过去，但我们可以确保未来不再重蹈覆辙。而且，我们三个...至少关系比以前更深了，对吧？",
          "emotion": "hopeful"
        },
        {
          "id": "xzz6p363kt",
          "characterId": "char_002",
          "text": "是的。共同经历过这一切，便是我们各自成长的一部分。平衡的艺术，在于妥协与坚守之间，找到那条脆弱却真实的线。",
          "emotion": "pensive"
        }
      ]
    },
    {
      "id": "ENDING_C",
      "type": "ending",
      "isStart": false,
      "isEnding": true,
      "position": {
        "x": 650,
        "y": 1400
      },
      "title": "沉寂的档案：秘密的守护",
      "sceneName": "学生宿舍",
      "backgroundId": "scene_003",
      "narration": "夜幕低垂，宿舍里只剩下台灯昏黄的光。失踪案的喧嚣早已平息，仿佛一切从未发生。但对于晓晨、雨萱和修远而言，那晚在图书馆地下室做出的抉择，如同沉重的石块，压在各自的心底，留下了一道无法愈合的裂痕。",
      "dialogues": [
        {
          "id": "lyuncfynbp",
          "characterId": "char_001",
          "text": "我们真的……就这样把一切都埋葬了吗？",
          "emotion": "regretful"
        },
        {
          "id": "ehd1wd9bgh",
          "characterId": "char_003",
          "text": "校报的头条本可以是真相大白，现在却只剩下无关痛痒的社团活动……我感觉自己像个背叛者。",
          "emotion": "guilty"
        },
        {
          "id": "7mnd0sg46k",
          "characterId": "char_002",
          "text": "有些秘密，被守护比被揭露，能带来更小的伤害。这是我们共同的选择。",
          "emotion": "calm"
        },
        {
          "id": "bi6xfrni7w",
          "characterId": "char_001",
          "text": "可是……那份正义呢？那些被遗忘的人，他们就真的只能沉寂了吗？",
          "emotion": "distressed"
        },
        {
          "id": "01rigk2h0z",
          "characterId": "char_003",
          "text": "我总觉得，我们牺牲了太多……比想象的还要多。",
          "emotion": "heavyhearted"
        },
        {
          "id": "n8qo2ue42g",
          "characterId": "char_002",
          "text": "历史自有其修正的方式。而我们，只是选择了当下最不坏的路径。",
          "emotion": "resigned"
        }
      ]
    }
  ],
