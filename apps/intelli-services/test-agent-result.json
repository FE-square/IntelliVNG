  "script": [
    {
      "id": "START",
      "type": "scene",
      "isStart": true,
      "isEnding": false,
      "position": {
        "x": 400,
        "y": 50
      },
      "title": "序章：图书馆里的窃窃私语",
      "sceneName": "图书馆阅览室",
      "backgroundId": "scene_001",
      "narration": "夏日午后的图书馆，空气中弥漫着旧书和木头的混合气味。学生们埋首书本，只有翻页的沙沙声偶尔打破沉寂。然而，今天这份平静中似乎多了一些不同寻常的低语。",
      "dialogues": [
        {
          "id": "r7nda3jao2",
          "characterId": "char_003",
          "text": "晓晨，你听说了吗？",
          "emotion": "excited"
        },
        {
          "id": "5eizu0mw0d",
          "characterId": "char_001",
          "text": "什么？你又挖到什么独家猛料了？别又是关于隔壁系那个校草的八卦啊。",
          "emotion": "curious"
        },
        {
          "id": "r7mze8bvnw",
          "characterId": "char_003",
          "text": "当然不是！这次可是正经事！最近学校里有些不太对劲，你没发现吗？",
          "emotion": "serious"
        },
        {
          "id": "uw6dcirnwt",
          "characterId": "char_001",
          "text": "嗯？怎么说？除了食堂的饭菜越来越难吃，我倒是没察觉到什么异样。",
          "emotion": "thoughtful"
        },
        {
          "id": "zkw4p42v36",
          "characterId": "char_003",
          "text": "嘘——小声点。我听新闻系的前辈说，最近校报接到了好多奇怪的投稿，都是关于后山禁区的。说是晚上总能听到奇怪的声响，还有人说看到...看到了一些不该出现的东西。",
          "emotion": "mysterious"
        },
        {
          "id": "he23st2wtz",
          "characterId": "char_001",
          "text": "奇怪的声响？不该出现的东西？这可有意思了...",
          "emotion": "intrigued"
        }
      ],
      "nextNodeId": "S1"
    },
    {
      "id": "S1",
      "type": "scene",
      "isStart": false,
      "isEnding": false,
      "position": {
        "x": 400,
        "y": 200
      },
      "title": "初探疑云：线索与直觉",
      "sceneName": "学生宿舍",
      "backgroundId": "scene_003",
      "narration": "宿舍里，台灯发出柔和的光，照亮了堆满零食和书籍的桌面。晓晨和雨萱相对而坐，空气中弥漫着一股紧张而兴奋的氛围，仿佛一场秘密行动即将拉开序幕。",
      "dialogues": [
        {
          "id": "3k8grpvba7",
          "characterId": "char_001",
          "text": "所以，雨萱，我们现在怎么办？那个后山禁区听起来就疑点重重！",
          "emotion": "excited"
        },
        {
          "id": "e3dsntnd80",
          "characterId": "char_003",
          "text": "别急，侦探小姐。这种事情不能硬闯，得从外围摸清情况。我打算从校报社团那边打听一下，他们对学校的各种传闻最清楚不过了。",
          "emotion": "thoughtful"
        },
        {
          "id": "3ou6nk77t7",
          "characterId": "char_001",
          "text": "嗯，好主意！那我就负责在校园里转转，看看能不能从学生们的日常对话里捕捉到什么蛛丝马迹。那些小道消息往往比官方说法更接近真相。",
          "emotion": "determined"
        },
        {
          "id": "gpwef5zbdf",
          "characterId": "char_003",
          "text": "小心点，晓晨。这种事情有时候比你想象的要复杂。别太冒失，知道吗？",
          "emotion": "concerned"
        },
        {
          "id": "lhnq2iprja",
          "characterId": "char_001",
          "text": "放心吧！我可是从小跟着我爸看刑侦剧长大的！你就等我的好消息吧！",
          "emotion": "confident"
        }
      ],
      "nextNodeId": "S2"
    },
    {
      "id": "S2",
      "type": "scene",
      "isStart": false,
      "isEnding": false,
      "position": {
        "x": 400,
        "y": 350
      },
      "title": "神秘管理员的警告",
      "sceneName": "图书馆阅览室",
      "backgroundId": "scene_001",
      "narration": "图书馆阅览室里，只剩下书页翻动的轻微声响。修远一如既往地坐在角落，戴着眼镜，沉浸在泛黄的古籍中。晓晨深吸一口气，鼓足勇气走上前去。",
      "dialogues": [
        {
          "id": "nnhuid9omm",
          "characterId": "char_001",
          "text": "修远同学，打扰了。我...我是刘晓晨，有些事情想请教你。",
          "emotion": "nervous"
        },
        {
          "id": "9f44drmqk4",
          "characterId": "char_002",
          "text": "......",
          "emotion": "calm"
        },
        {
          "id": "pk7ed4s6qg",
          "characterId": "char_001",
          "text": "我听说你对学校里的一些传闻很了解，特别是关于后山禁区的...我想知道那里面究竟有什么？",
          "emotion": "curious"
        },
        {
          "id": "kgsgv995wi",
          "characterId": "char_002",
          "text": "有些地方，光是好奇...就足够引来麻烦。",
          "emotion": "serious"
        },
        {
          "id": "0cygkj0onf",
          "characterId": "char_001",
          "text": "可是，我觉得这很重要。这可能和之前发生的一些不寻常的事情有关，甚至和那些突然消失的学生...",
          "emotion": "determined"
        },
        {
          "id": "he6ehexf2m",
          "characterId": "char_002",
          "text": "不该问的别问，不该看的别看。禁区有它的秘密，也有它的代价。记住...过去，总会纠缠不清。你，还太稚嫩。",
          "emotion": "grave"
        }
      ],
      "nextNodeId": "B1"
    },
    {
      "id": "B1",
      "type": "branch",
      "isStart": false,
      "isEnding": false,
      "position": {
        "x": 400,
        "y": 500
      },
      "title": "校报风波：发声的艺术",
      "sceneName": "校报编辑部",
      "narration": "校报编辑部里气氛凝重，陈主任那张不苟言笑的脸，让空气都仿佛凝固了。桌上的稿件，标题赫然写着关于‘后山禁区异闻’的字样。",
      "dialogues": [
        {
          "id": "simvehst2v",
          "characterId": "7ou0w28wmj",
          "text": "方同学，这篇关于后山禁区和所谓‘失踪学生’的稿件...内容过于敏感，不适合刊登。校方需要维护学校的声誉和稳定。",
          "emotion": "stern"
        },
        {
          "id": "emh94xxjbm",
          "characterId": "char_003",
          "text": "主任，我们作为校报，有责任报道真相！这些都是学生们高度关注的焦点，校方不应选择一味压制，而是应该正视问题！",
          "emotion": "resolute"
        },
        {
          "id": "dn60wv0fit",
          "characterId": "7ou0w28wmj",
          "text": "有些‘真相’，其本身就是谣言的温床。校方已经有明确指示，关于禁区和类似事件，一律不予报道。这是为了保护学生，也是为了大局着想。",
          "emotion": "authoritative"
        },
        {
          "id": "akrw90bcrh",
          "characterId": "char_003",
          "text": "保护学生？还是掩盖什么？我们只是想通过新闻，引起更多关注，也许能找到线索！",
          "emotion": "frustrated"
        },
        {
          "id": "ylh4x3xoil",
          "characterId": "7ou0w28wmj",
          "text": "我理解你的热忱，方同学。但记者要有大局观，不要做一些...不必要的冒险。校报的资源是有限的，希望你明白轻重，否则后果自负。",
          "emotion": "warning"
        }
      ],
      "choices": [
        {
          "id": "B1C1",
          "text": "暂时退让，寻找其他突破口（表面顺从，暗中调查）",
          "targetNodeId": "S3a",
          "condition": "暂时规避了风险，但真相依旧扑朔迷离。"
        },
        {
          "id": "B1C2",
          "text": "坚持立场，公开发声（即便面临处分）",
          "targetNodeId": "S3b",
          "condition": "引发了小范围关注，但也带来了校方的严厉打压。"
        }
      ]
    },
    {
      "id": "S3a",
      "type": "scene",
      "isStart": false,
      "isEnding": false,
      "position": {
        "x": 275,
        "y": 650
      },
      "title": "曲线策略：暗流涌动",
      "sceneName": "学生宿舍",
      "backgroundId": "scene_003",
      "narration": "学生宿舍里，夜幕低垂。台灯发出柔和的光，将两张床铺前的书桌映得明亮。雨萱把校报的审稿意见书揉成一团，扔进了垃圾桶。虽然表面上接受了校方的审查，但她眼底的火焰并未熄灭，反而燃烧得更加隐蔽。",
      "dialogues": [
        {
          "id": "1y74qyfuk1",
          "characterId": "char_003",
          "text": "哼，‘报道失实’，‘煽动情绪’？这些冠冕堂皇的理由，无非是不想我们触碰禁区罢了。",
          "emotion": "annoyed"
        },
        {
          "id": "b4igdqz7cp",
          "characterId": "char_001",
          "text": "那...我们真的要就这么算了？后山禁区的事情，肯定有猫腻！",
          "emotion": "disappointed"
        },
        {
          "id": "j4wm5gutzw",
          "characterId": "char_003",
          "text": "当然不会算了。只是，硬碰硬不行，咱们得曲线救国。表面上乖乖听话，私底下...照查不误。",
          "emotion": "determined"
        },
        {
          "id": "2anll6b817",
          "characterId": "char_001",
          "text": "太棒了！我就知道你不会轻易放弃的！那我们下一步怎么做？上次我们找到的那些线索...",
          "emotion": "excited"
        },
        {
          "id": "grfin0mov5",
          "characterId": "char_003",
          "text": "嘘！小点声。现在校方肯定盯着我们呢。以后讨论这些，都要小心。先从校外图书馆和旧报纸开始，绕开学校的视线。",
          "emotion": "cautious"
        },
        {
          "id": "ehepyjhyrw",
          "characterId": "char_001",
          "text": "明白！秘密行动，化整为零！放心吧，我保证不露马脚！",
          "emotion": "resolute"
        }
      ],
      "nextNodeId": "S4"
    },
    {
      "id": "S3b",
      "type": "scene",
      "isStart": false,
      "isEnding": false,
      "position": {
        "x": 525,
        "y": 650
      },
      "title": "舆论萌芽：星星之火",
      "sceneName": "校园林荫道",
      "backgroundId": "scene_002",
      "narration": "初秋的阳光透过林荫道斑驳地洒下，树叶沙沙作响。雨萱独自走着，她的脸上带着一丝疲惫，却又掩不住眼底的几分激动。",
      "dialogues": [
        {
          "id": "5nbs1yh01l",
          "characterId": "char_001",
          "text": "雨萱！你怎么一个人在这里发呆？校报的会议结束了吗？",
          "emotion": "curious"
        },
        {
          "id": "xjhq5fxklu",
          "characterId": "char_003",
          "text": "结束了，也…‘结束’了。我的报道，被撤下来了。",
          "emotion": "frustrated"
        },
        {
          "id": "3rgrsbd42s",
          "characterId": "char_001",
          "text": "什么？！真的被撤了？太过分了！那篇报道明明写得那么好！",
          "emotion": "angry"
        },
        {
          "id": "dsamkdsk9c",
          "characterId": "char_003",
          "text": "是啊，他们说‘影响不好’。不过…你知道吗，晓晨？虽然校报没发，但我昨晚在校园论坛上匿名发了个帖子，揭露了这件事，现在已经炸锅了！",
          "emotion": "excited"
        },
        {
          "id": "iosatsl7ga",
          "characterId": "char_001",
          "text": "哇！论坛炸锅了？！快给我看看！我就说嘛，真相是藏不住的！",
          "emotion": "eager"
        },
        {
          "id": "6nu2qch7ne",
          "characterId": "char_003",
          "text": "嗯。虽然只是星星之火，但至少有人关注了。我觉得…我们离真相又近了一步。",
          "emotion": "determined"
        }
      ],
      "nextNodeId": "S4"
    },
    {
      "id": "S4",
      "type": "scene",
      "isStart": false,
      "isEnding": false,
      "position": {
        "x": 400,
        "y": 800
      },
      "title": "密谋：地下室探险",
      "sceneName": "图书馆阅览室",
      "backgroundId": "scene_001",
      "narration": "图书馆阅览室里，阳光透过落地窗洒在书架上，空气中弥漫着淡淡的书香。晓晨和雨萱找到了坐在角落里看书的修远，两人眼中都带着不容置疑的坚定。",
      "dialogues": [
        {
          "id": "v6u6dkpma9",
          "characterId": "char_001",
          "text": "修远，我们知道你一定了解些什么。关于图书馆地下室，你到底知道多少？",
          "emotion": "determined"
        },
        {
          "id": "4sbnuqjcq2",
          "characterId": "char_002",
          "text": "两位同学，有些地方，不是你们想去就能去的。更何况，那里已经封闭了很久。",
          "emotion": "calm"
        },
        {
          "id": "lxn3x4q5ld",
          "characterId": "char_003",
          "text": "但那里可能是我们找到真相的唯一线索！校方不让我们去后山，我们就只能另辟蹊径了。",
          "emotion": "earnest"
        },
        {
          "id": "y4dnm62v8u",
          "characterId": "char_001",
          "text": "我们已经决定了。就算再危险，也要把事情查清楚。你帮我们，还是不帮？",
          "emotion": "insistent"
        },
        {
          "id": "1tivghqlkt",
          "characterId": "char_002",
          "text": "唉... 看来是拦不住你们了。好吧，我可以告诉你们一些事情，甚至可以带你们进去...",
          "emotion": "resigned"
        },
        {
          "id": "lotdf3bsyo",
          "characterId": "char_002",
          "text": "但你们必须明白，那地方远比你们想象的危险。一旦踏入那里，就没人能保证你们的安全。考虑清楚，这可不是儿戏。",
          "emotion": "serious"
        }
      ],
      "nextNodeId": "S5"
    },
    {
      "id": "S5",
      "type": "scene",
      "isStart": false,
      "isEnding": false,
      "position": {
        "x": 400,
        "y": 950
      },
      "title": "禁区：尘封的档案",
      "sceneName": "图书馆地下室",
      "backgroundId": "scene_004",
      "narration": "潮湿而冰冷的空气扑面而来，地下室深邃的黑暗被手电筒的光束艰难地撕裂。霉味和纸张腐朽的气息混杂在一起，四周堆满了落满灰尘的旧书架和蒙着白布的神秘箱子。",
      "dialogues": [
        {
          "id": "3aat82j8uw",
