    "script": [
      {
        "id": "start",
        "type": "scene",
        "isStart": true,
        "isEnding": false,
        "position": {
          "x": 400,
          "y": 50
        },
        "title": "宿舍夜谈",
        "sceneName": "学生宿舍",
        "backgroundId": "scene_003",
        "narration": "夜幕降临，宿舍里只有你和室友雨萱。",
        "dialogues": [
          {
            "id": "0lkh3g2phs",
            "characterId": "char_003",
            "text": "晓晨，你听说了吗？最近学校里又发生怪事了！"
          },
          {
            "id": "lxktdxniko",
            "characterId": "char_001",
            "text": "怪事？你是说图书馆里半夜传出奇怪声音的事情？"
          },
          {
            "id": "glzgo9xwak",
            "characterId": "char_003",
            "text": "不止呢！还有人说，好几个同学都在图书馆某个角落看到了模糊的人影，然后就生病了！"
          },
          {
            "id": "g660p086ia",
            "characterId": "char_001",
            "text": "嗯……听起来不像是简单的恶作剧。"
          },
          {
            "id": "6ph57fniqc",
            "characterId": "char_003",
            "text": "对啊！我可是校报记者，这种独家新闻我怎么能放过！你不是对这些神秘事件最感兴趣吗？"
          },
          {
            "id": "fdbyuxlpl",
            "characterId": "char_001",
            "text": "当然！我爸爸以前可是刑警，这种案子我可不会袖手旁观。"
          },
          {
            "id": "shpo7xuiiv",
            "characterId": "char_003",
            "text": "（小声）不过，图书馆那地方阴森森的，我觉得还是有点怕怕的…"
          },
          {
            "id": "u54e1iroko",
            "characterId": "char_001",
            "text": "别怕，有我在呢！明天我就去图书馆一趟。"
          },
          {
            "id": "5xki81w14z",
            "characterId": "char_003",
            "text": "好！有什么发现记得第一时间告诉我啊！"
          },
          {
            "id": "tktjiivoqf",
            "characterId": "char_001",
            "text": "没问题！"
          }
        ],
        "nextNodeId": "node-2"
      },
      {
        "id": "node-2",
        "type": "scene",
        "isStart": false,
        "isEnding": false,
        "position": {
          "x": 400,
          "y": 250
        },
        "title": "前往图书馆",
        "sceneName": "校园林荫道",
        "backgroundId": "scene_002",
        "narration": "第二天，你走在通往图书馆的林荫道上，阳光透过树叶洒下斑驳的光影。",
        "dialogues": [
          {
            "id": "ktxt3b5qid",
            "characterId": "char_001",
            "text": "（自言自语）图书馆的怪事……会是什么呢？是有人恶作剧，还是真的有不为人知的秘密？"
          },
          {
            "id": "arsyh19xg",
            "characterId": "char_001",
            "text": "爸爸常说，所有线索都会指向真相。图书馆是学校最古老的地方，也许能找到些什么。"
          },
          {
            "id": "60n0uvg3yy",
            "characterId": "char_003",
            "text": "（突然出现在旁边）晓晨！你可要小心啊，图书馆管理员修远，那人神神秘秘的。"
          },
          {
            "id": "03biqeh7kg",
            "characterId": "char_001",
            "text": "修远？我见过他，总是在图书馆里看书，话不多。"
          },
          {
            "id": "d8fq41ebeg",
            "characterId": "char_003",
            "text": "对啊！他好像知道很多学校的旧事，但从来不主动说。我总觉得他身上藏着什么。"
          },
          {
            "id": "yw3k7ej6vp",
            "characterId": "char_001",
            "text": "嗯，谢谢你的提醒。我会留意的。"
          },
          {
            "id": "a3ijc432rm",
            "characterId": "char_003",
            "text": "别忘了我的独家新闻啊！"
          },
          {
            "id": "mue24umy1d",
            "characterId": "char_001",
            "text": "知道啦！"
          }
        ],
        "nextNodeId": "node-3_branch_investigation_start"
      },
      {
        "id": "node-3_branch_investigation_start",
        "type": "branch",
        "isStart": false,
        "isEnding": false,
        "position": {
          "x": 400,
          "y": 450
        },
        "title": "图书馆的抉择",
        "sceneName": "图书馆阅览室",
        "backgroundId": "scene_001",
        "narration": "你来到了百年图书馆的阅览室，空气中弥漫着书香和灰尘的味道。修远正坐在角落里，戴着眼镜安静地读书。",
        "dialogues": [
          {
            "id": "onp1mmka3n",
            "characterId": "char_001",
            "text": "（看着修远）他会知道些什么吗？直接问他，还是先自己找线索？"
          }
        ],
        "choices": [
          {
            "id": "x1wiw8j9eu",
            "text": "上前询问修远",
            "targetNodeId": "node-4_talk_to_xiuyuan",
            "condition": "询问修远"
          },
          {
            "id": "7ha7wpdxy3",
            "text": "先自己查阅资料",
            "targetNodeId": "node-4_research_alone",
            "condition": "独自查阅"
          }
        ]
      },
      {
        "id": "node-4_talk_to_xiuyuan",
        "type": "scene",
        "isStart": false,
        "isEnding": false,
        "position": {
          "x": 200,
          "y": 650
        },
        "title": "修远的暗示",
        "sceneName": "图书馆阅览室",
        "backgroundId": "scene_001",
        "narration": "你走到修远面前，他缓缓抬起头，眼神平静。",
        "dialogues": [
          {
            "id": "u111do308y",
            "characterId": "char_001",
            "text": "你好，修远学长。我想问一下，最近图书馆里是不是发生了一些奇怪的事情？"
          },
          {
            "id": "7cil0mcpqe",
            "characterId": "char_002",
            "text": "（放下书，推了推眼镜）奇怪的事情……每天都在发生。你指的是哪种？"
          },
          {
            "id": "d2jbjlw6er",
            "characterId": "char_001",
            "text": "就是……有人看到人影，听到怪声之类的。大家都在传。"
          },
          {
            "id": "sbeufhyavm",
            "characterId": "char_002",
            "text": "（眼神深邃）传闻，往往是真相的碎片。如果你想找到真相，就不能只看表面。"
          },
          {
            "id": "7gq9qh5awx",
            "characterId": "char_002",
            "text": "有些地方，被遗忘，不代表不存在。只是，很少有人敢去触碰。"
          },
          {
            "id": "6ms3zxaiu9",
            "characterId": "char_001",
            "text": "被遗忘的地方……学长指的是哪里？"
          },
          {
            "id": "ru73wy9cye",
            "characterId": "char_002",
            "text": "（拿起书，不再言语）"
          },
          {
            "id": "5zt6t236e5",
            "characterId": "char_001",
            "text": "（他似乎不想多说，但他的话语中充满了暗示……）"
          }
        ],
        "nextNodeId": "node-5_branch_xiuyuan_hints"
      },
      {
        "id": "node-5_branch_xiuyuan_hints",
        "type": "branch",
        "isStart": false,
        "isEnding": false,
        "position": {
          "x": 200,
          "y": 850
        },
        "title": "解读暗示",
        "sceneName": "图书馆阅览室",
        "backgroundId": "scene_001",
        "narration": "修远不再说话，你思索着他“被遗忘的地方”这句话。",
        "dialogues": [
          {
            "id": "4zw645vqdg",
            "characterId": "char_001",
            "text": "他到底想告诉我什么？是让我继续追问，还是自己去寻找？"
          }
        ],
        "choices": [
          {
            "id": "z9wmukavd5",
            "text": "追问修远更多细节",
            "targetNodeId": "node-6_xiuyuan_reveals_more",
            "condition": "追问细节"
          },
          {
            "id": "4e1dd3fvtp",
            "text": "结合暗示独自行动",
            "targetNodeId": "node-7_to_basement_alone",
            "condition": "独立行动"
          }
        ]
      },
      {
        "id": "node-6_xiuyuan_reveals_more",
        "type": "scene",
        "isStart": false,
        "isEnding": false,
        "position": {
          "x": 100,
          "y": 1050
        },
        "title": "修远的警告",
        "sceneName": "图书馆阅览室",
        "backgroundId": "scene_001",
        "narration": "你再次尝试向修远询问，他叹了口气，似乎做出了某种决定。",
        "dialogues": [
          {
            "id": "q8dboqk7ia",
            "characterId": "char_001",
            "text": "学长，我真的想知道真相。那些被遗忘的地方，是不是和图书馆的地下室有关？"
          },
          {
            "id": "ns2tkavbrz",
            "characterId": "char_002",
            "text": "（合上书，眼神严肃）地下室……那里尘封着学校最不愿提及的历史。几十年前，图书馆曾发生过一起意外。"
          },
          {
            "id": "ltdfibkbau",
            "characterId": "char_002",
            "text": "一些旧的档案和记录，都被匆忙地锁在了地下室。如果你想去，务必小心。有些真相，代价沉重。"
          },
          {
            "id": "1n0gwm72be",
            "characterId": "char_001",
            "text": "意外？什么意外？"
          },
          {
            "id": "36goti00j5",
            "characterId": "char_002",
            "text": "（摇了摇头）我能说的只有这么多。希望你能找到你想知道的。"
          },
          {
            "id": "8hmw6kyv5m",
            "characterId": "char_001",
            "text": "（看来他已经给了我足够的提示了，地下室，看来是关键。）"
          }
        ],
        "nextNodeId": "node-8_climax_basement"
      },
      {
        "id": "node-4_research_alone",
        "type": "scene",
        "isStart": false,
        "isEnding": false,
        "position": {
