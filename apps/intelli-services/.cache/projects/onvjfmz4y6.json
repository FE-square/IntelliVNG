      {
        "id": "node-6_share_with_yuxuan",
        "type": "scene",
        "isStart": false,
        "isEnding": false,
        "position": {
          "x": 700,
          "y": 1050
        },
        "title": "雨萱的帮助",
        "sceneName": "校园林荫道",
        "backgroundId": "scene_002",
        "narration": "你立即联系了雨萱，并将发现告诉了她。她在林荫道上焦急地等你。",
        "dialogues": [
          {
            "id": "0u7qk5sxuk",
            "characterId": "char_003",
            "text": "什么？！几十年前的旧事，还有被封闭的地下室？"
          },
          {
            "id": "5ihze6uzdw",
            "characterId": "char_001",
            "text": "对，我觉得那里面一定有我们想知道的真相。"
          },
          {
            "id": "4dkysh5qdx",
            "characterId": "char_003",
            "text": "太棒了！我这就去打听！说不定能从学校的老教授那里挖到点什么！"
          },
          {
            "id": "a4bk8l469a",
            "characterId": "char_003",
            "text": "（过了一会儿，她再次联系你）晓晨，我问到了！老教授说，当年确实发生过一起实验室事故，但学校对外声称是普通火灾。所有相关文件都被封存了！"
          },
          {
            "id": "ixc9wq6zgf",
            "characterId": "char_001",
            "text": "实验室事故？还被封存？看来地下室就是突破口了！"
          },
          {
            "id": "5v1mh0enu2",
            "characterId": "char_003",
            "text": "嗯！不过你一个人去太危险了，要不我找人帮忙？"
          },
          {
            "id": "z7t69ectvx",
            "characterId": "char_001",
            "text": "不用，我已经有足够的信息了。地下室，我来了！"
          }
        ],
        "nextNodeId": "node-8_climax_basement"
      },
      {
        "id": "node-7_to_basement_alone",
        "type": "scene",
        "isStart": false,
        "isEnding": false,
        "position": {
          "x": 400,
          "y": 1250
        },
        "title": "独自潜入地下室",
        "sceneName": "图书馆地下室",
        "backgroundId": "scene_004",
        "narration": "你独自一人找到了图书馆地下室的入口。铁门锈迹斑斑，散发着潮湿和霉味。",
        "dialogues": [
          {
            "id": "cg8mpoumbm",
            "characterId": "char_001",
            "text": "（深吸一口气）果然是这里……阴森森的，感觉空气都凝固了。"
          },
          {
