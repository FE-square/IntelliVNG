{
    "name": "intellivng",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "dev:web": "turbo run dev --filter=web",
        "dev:serv": "turbo run dev --filter=intelli-services",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\""
    },
    "devDependencies": {
        "turbo": "^1.10.0",
        "prettier": "^3.0.0",
        "typescript": "^5.0.0"
    },
    "packageManager": "pnpm@10.24.0",
    "engines": {
        "node": ">=18"
    }
}
